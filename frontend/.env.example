# ================================
# RIBIF Frontend Environment Example
# Copy to frontend/.env.local (or frontend/.env)
# ================================

# Backend API base URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Used in current code for admin-like operations; avoid exposing in production builds
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=

# Voice negotiation UI (Vapi)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Optional test-only vars (used by live supabase tests)
SUPABASE_TEST_LIVE=0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TEST_SERVICE_KEY=
SUPABASE_TEST_BUCKET=project-files
SUPABASE_TEST_OWNER_ID=
